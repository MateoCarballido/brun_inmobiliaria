<%- include('partials/header') %>

<section class="contact-hero">
  <h1>Contacto</h1>
  <p>Estamos para ayudarte. Dejanos tu consulta y te responderemos a la brevedad.</p>
</section>

<section class="contact-layout">
  <aside class="contact-info-card">
    <article class="contact-info-item">
      <span class="contact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M5 4h4l2 5-2 1.5a15 15 0 0 0 4.5 4.5L15 13l5 2v4a2 2 0 0 1-2.2 2C10 20.5 3.5 14 3 6.2A2 2 0 0 1 5 4z"></path></svg>
      </span>
      <div>
        <h3>Telefono</h3>
        <p>+54 11 1234-5678</p>
        <p>+54 11 8765-4321</p>
      </div>
    </article>

    <article class="contact-info-item">
      <span class="contact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 8l9 6 9-6"></path></svg>
      </span>
      <div>
        <h3>Email</h3>
        <p>propiedadesbrun@gmail.com</p>
      </div>
    </article>

    <article class="contact-info-item">
      <span class="contact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10z"></path><circle cx="12" cy="11" r="2.3"></circle></svg>
      </span>
      <div>
        <h3>Direccion</h3>
        <p>Av. Santa Fe 1234</p>
        <p>Buenos Aires, Argentina</p>
      </div>
    </article>

    <article class="contact-info-item">
      <span class="contact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
      </span>
      <div>
        <h3>Horarios</h3>
        <p>Lunes a Viernes: 9:00 - 18:00</p>
        <p>Sabados: 10:00 - 14:00</p>
      </div>
    </article>
  </aside>

  <section class="contact-form-card">
    <% if (typeof authNotice !== 'undefined' && authNotice) { %>
      <p class="notice"><%= authNotice %></p>
    <% } %>

    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <p class="success"><%= successMessage %></p>
    <% } %>

    <form action="/contacto" method="post" class="contact-form contact-grid-form">
      <div>
        <label for="nombre">Nombre completo *</label>
        <input id="nombre" name="nombre" type="text" required placeholder="Juan Perez" />
      </div>

      <div>
        <label for="email">Email *</label>
        <input id="email" name="email" type="email" required placeholder="juan@ejemplo.com" />
      </div>

      <div>
        <label for="telefono">Telefono *</label>
        <input id="telefono" name="telefono" type="text" required placeholder="+54 11 1234-5678" />
      </div>

      <div>
        <label for="asunto">Asunto *</label>
        <select id="asunto" name="asunto" required>
          <option value="">Seleccionar</option>
          <option value="compra">Quiero comprar</option>
          <option value="alquiler">Quiero alquilar</option>
          <option value="tasacion">Tasacion</option>
          <option value="otro">Otro</option>
        </select>
      </div>

      <div class="full-row">
        <label for="mensaje">Mensaje *</label>
        <textarea id="mensaje" name="mensaje" rows="4" required placeholder="Contanos en que podemos ayudarte..."></textarea>
      </div>

      <button type="submit" class="btn btn-dark full-row">Enviar mensaje</button>
    </form>
  </section>
</section>

<%- include('partials/footer') %>
