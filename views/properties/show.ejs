<%- include('../partials/header') %>
<%
function resolveImageSrc(value) {
  if (!value) return '/images/placeholder-property.svg';
  const raw = String(value);
  if (raw.startsWith('http://') || raw.startsWith('https://') || raw.startsWith('/')) return raw;
  return '/images/' + raw.replace(/^images\//, '').replace(/^\/images\//, '');
}

function getGalleryImages(currentProperty) {
  const images = [];
  const pushIfNew = function (value) {
    const resolved = resolveImageSrc(value);
    if (!images.includes(resolved)) {
      images.push(resolved);
    }
  };

  if (currentProperty.imagen_principal) {
    pushIfNew(currentProperty.imagen_principal);
  }

  if (currentProperty.images && currentProperty.images.length > 0) {
    currentProperty.images
      .slice()
      .sort(function (a, b) { return Number(a.orden || 0) - Number(b.orden || 0); })
      .forEach(function (image) {
        pushIfNew(image.url);
      });
  }

  if (images.length === 0) {
    pushIfNew(currentProperty.imagen);
  }

  if (images.length === 0) {
    pushIfNew(null);
  }

  return images;
}

function formatPropertyType(value) {
  const normalized = String(value || 'Propiedad').replace(/_/g, ' ').trim().toLowerCase();
  if (!normalized) return 'Propiedad';
  return normalized.charAt(0).toUpperCase() + normalized.slice(1);
}

function formatCurrencyLabel(currency) {
  return currency === 'ARS' ? '$' : 'USD';
}

function getWhatsappShareLink(currentProperty, currentShareUrl) {
  const message = [
    'Hola, te comparto esta propiedad:',
    currentProperty.titulo,
    currentProperty.ubicacion ? 'Ubicacion: ' + currentProperty.ubicacion : null,
    'Precio: ' + formatCurrencyLabel(currentProperty.moneda) + ' ' + Number(currentProperty.precio).toLocaleString('es-AR'),
    currentShareUrl
  ].filter(Boolean).join('\n');

  return 'https://wa.me/?text=' + encodeURIComponent(message);
}

const galleryImages = getGalleryImages(property);
const whatsappShareLink = getWhatsappShareLink(property, shareUrl);
%>

<section class="property-hero">
  <div class="detail-gallery" data-gallery-images='<%- JSON.stringify(galleryImages) %>'>
    <div class="detail-image-button" id="open-gallery-lightbox" role="button" tabindex="0" aria-label="Ampliar imagen principal">
      <img
        src="<%= galleryImages[0] %>"
        alt="<%= property.titulo %>"
        class="detail-image"
        id="detail-main-image"
      />
      <span class="detail-image-hint">Tocar para ampliar</span>
    </div>

    <% if (galleryImages.length > 1) { %>
      <button type="button" class="gallery-arrow gallery-prev" id="gallery-prev" aria-label="Imagen anterior">&#10094;</button>
      <button type="button" class="gallery-arrow gallery-next" id="gallery-next" aria-label="Imagen siguiente">&#10095;</button>
      <div class="gallery-counter" id="gallery-counter">1 / <%= galleryImages.length %></div>
    <% } %>
  </div>

  <% if (galleryImages.length > 1) { %>
    <div class="gallery-thumbs" id="gallery-thumbs">
      <% galleryImages.forEach(function(imageSrc, index) { %>
        <button
          type="button"
          class="gallery-thumb <%= index === 0 ? 'is-active' : '' %>"
          data-gallery-index="<%= index %>"
          aria-label="Ver imagen <%= index + 1 %>"
        >
          <img src="<%= imageSrc %>" alt="<%= property.titulo %> - imagen <%= index + 1 %>" />
        </button>
      <% }) %>
    </div>
  <% } %>
</section>

<div class="gallery-lightbox" id="gallery-lightbox" hidden>
  <div class="gallery-lightbox-shell">
    <div class="gallery-lightbox-toolbar">
      <div class="gallery-lightbox-zoom-controls">
        <button type="button" class="gallery-lightbox-action" id="zoom-out-lightbox" aria-label="Alejar imagen">-</button>
        <button type="button" class="gallery-lightbox-action" id="reset-zoom-lightbox" aria-label="Restablecer zoom">100%</button>
        <button type="button" class="gallery-lightbox-action" id="zoom-in-lightbox" aria-label="Acercar imagen">+</button>
      </div>
      <button type="button" class="gallery-lightbox-close" id="close-gallery-lightbox" aria-label="Cerrar imagen ampliada">&times;</button>
    </div>
    <div class="gallery-lightbox-stage" id="gallery-lightbox-stage">
      <% if (galleryImages.length > 1) { %>
        <button type="button" class="gallery-lightbox-nav gallery-lightbox-prev" id="gallery-lightbox-prev" aria-label="Imagen anterior">&#10094;</button>
        <button type="button" class="gallery-lightbox-nav gallery-lightbox-next" id="gallery-lightbox-next" aria-label="Imagen siguiente">&#10095;</button>
      <% } %>
      <img src="<%= galleryImages[0] %>" alt="<%= property.titulo %>" class="gallery-lightbox-image" id="gallery-lightbox-image" />
    </div>
  </div>
</div>

<section class="property-page-grid">
  <article class="property-main-card">
    <div class="property-toolbar no-print">
      <button type="button" class="btn btn-light property-print-btn" id="print-property-sheet">Imprimir ficha</button>
      <a
        href="<%= whatsappShareLink %>"
        class="btn btn-dark property-share-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Compartir por WhatsApp"
        title="Compartir por WhatsApp"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M19.05 4.91A9.82 9.82 0 0 0 12.03 2C6.62 2 2.2 6.4 2.2 11.82c0 1.74.45 3.43 1.31 4.93L2 22l5.4-1.41a9.8 9.8 0 0 0 4.63 1.18h.01c5.41 0 9.83-4.4 9.83-9.82 0-2.62-1.02-5.08-2.82-6.94Zm-7.02 15.2h-.01a8.14 8.14 0 0 1-4.14-1.13l-.3-.18-3.2.84.85-3.12-.2-.32a8.15 8.15 0 0 1-1.26-4.38c0-4.5 3.67-8.16 8.18-8.16 2.18 0 4.23.84 5.77 2.39a8.08 8.08 0 0 1 2.39 5.77c0 4.5-3.68 8.16-8.18 8.16Zm4.47-6.1c-.24-.12-1.4-.69-1.62-.77-.22-.08-.38-.12-.54.12-.16.24-.62.77-.76.93-.14.16-.28.18-.52.06-.24-.12-1-.37-1.92-1.18-.71-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.43-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.4h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2 0 1.18.86 2.32.98 2.48.12.16 1.68 2.57 4.07 3.6.57.25 1.02.4 1.37.5.58.19 1.1.16 1.52.1.46-.07 1.4-.57 1.6-1.12.2-.55.2-1.03.14-1.12-.06-.1-.22-.16-.46-.28Z"/>
        </svg>
      </a>
    </div>

    <div class="property-tags">
      <span class="badge badge-dark"><%= property.operacion === 'alquiler' ? 'Alquiler' : 'Venta' %></span>
      <span class="badge badge-light inline-badge"><%= formatPropertyType(property.tipo) %></span>
    </div>

    <h1 class="property-title"><%= property.titulo %></h1>
    <p class="location location-line property-address-line">
      <span class="mini-svg" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
          <path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10z"></path>
          <circle cx="12" cy="11" r="2.3"></circle>
        </svg>
      </span>
      <%= property.ubicacion %>
    </p>

    <% if (property.direccion) { %>
      <p class="property-street"><%= property.direccion %></p>
    <% } %>

    <p class="property-price"><%= formatCurrencyLabel(property.moneda) %> <%= Number(property.precio).toLocaleString('es-AR') %></p>

    <div class="property-metrics">
      <div class="metric-card">
        <span class="metric-label">Dormitorios</span>
        <strong><%= property.dormitorios || '-' %></strong>
      </div>
      <div class="metric-card">
        <span class="metric-label">Baños</span>
        <strong><%= property.banios || '-' %></strong>
      </div>
      <div class="metric-card">
        <span class="metric-label"><%= property.tipo === 'departamento' ? 'Piso' : 'Plantas' %></span>
        <strong><%= property.tipo === 'departamento' ? (property.piso || '-') : (property.plantas || '-') %></strong>
      </div>
      <div class="metric-card">
        <span class="metric-label">Cubierta</span>
        <strong><%= property.superficie_cubierta_m2 || '-' %> m2</strong>
      </div>
      <div class="metric-card">
        <span class="metric-label">Total</span>
        <strong><%= property.superficie_total_m2 || property.superficie_m2 || '-' %> m2</strong>
      </div>
    </div>

    <section class="property-description collapsible-card">
      <button
        type="button"
        class="collapse-toggle"
        data-collapse-target="property-description-panel"
        aria-expanded="true"
      >
        <span>Descripcion</span>
        <span class="collapse-icon">▾</span>
      </button>
      <div id="property-description-panel" class="collapse-panel">
        <p><%= property.descripcion || 'Sin descripcion cargada.' %></p>
      </div>
    </section>

    <section class="property-print-contact print-only">
      <h2>Contacto</h2>
      <p><strong>Pablo:</strong> 11.5839.9513</p>
      <p><strong>Martina:</strong> 11.4163.0630</p>
      <p><strong>Guillermo:</strong> 11.5023.0639</p>
      <p><strong>Email:</strong> propiedadesbrun@gmail.com</p>
    </section>

  </article>

  <aside class="property-side-column">
    <section class="contact-box property-contact-card">
      <h2>Contactar</h2>
      <p>Dejanos tus datos y preparamos el mail automaticamente.</p>

      <% if (authNotice) { %>
        <p class="notice"><%= authNotice %></p>
      <% } %>

      <% if (successMessage) { %>
        <p class="success"><%= successMessage %></p>
      <% } %>

      <% if (mailtoLink) { %>
        <a class="btn" href="<%= mailtoLink %>" target="_blank" rel="noopener noreferrer">Abrir cliente de mail</a>
      <% } %>

      <form action="/propiedades/<%= property.id %>/contacto" method="post" class="contact-form">
        <label for="nombre">Nombre completo</label>
        <input id="nombre" name="nombre" type="text" required placeholder="Juan Perez" />

        <label for="email">Email</label>
        <input id="email" name="email" type="email" required placeholder="juan@ejemplo.com" />

        <label for="telefono">Telefono</label>
        <input id="telefono" name="telefono" type="text" placeholder="11.5839.9513" />

        <label for="mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="4">Hola, me interesa <%= property.titulo %> (<%= formatCurrencyLabel(property.moneda) %> <%= Number(property.precio).toLocaleString('es-AR') %>). Me gustaría recibir más información.</textarea>

        <button type="submit" class="btn btn-dark">Enviar consulta</button>
      </form>
    </section>

    <section class="contact-box property-contact-info collapsible-card">
      <button
        type="button"
        class="collapse-toggle"
        data-collapse-target="property-contact-info-panel"
        aria-expanded="false"
      >
        <span>Contacto directo</span>
        <span class="collapse-icon">▾</span>
      </button>
      <div id="property-contact-info-panel" class="collapse-panel is-collapsed">
        <p><strong>Pablo:</strong> <a class="mail-contact-btn" href="https://wa.me/5491158399513" target="_blank" rel="noopener noreferrer">11.5839.9513</a></p>
        <p><strong>Martina:</strong> <a class="mail-contact-btn" href="https://wa.me/5491141630630" target="_blank" rel="noopener noreferrer">11.4163.0630</a></p>
        <p><strong>Guillermo:</strong> <a class="mail-contact-btn" href="https://wa.me/5491150230639" target="_blank" rel="noopener noreferrer">11.5023.0639</a></p>
        <p><strong>Email:</strong> <a class="mail-contact-btn" href="https://mail.google.com/mail/?view=cm&fs=1&to=propiedadesbrun@gmail.com" target="_blank" rel="noopener noreferrer">propiedadesbrun@gmail.com</a></p>
      </div>
    </section>
  </aside>
</section>

<script>
  (function () {
    const wrapper = document.querySelector('.detail-gallery');
    if (!wrapper) return;

    let images = [];
    try {
      images = JSON.parse(wrapper.getAttribute('data-gallery-images') || '[]');
    } catch (error) {
      images = [];
    }

    const imageEl = document.getElementById('detail-main-image');
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');
    const counterEl = document.getElementById('gallery-counter');
    const thumbButtons = Array.from(document.querySelectorAll('[data-gallery-index]'));
    const lightboxEl = document.getElementById('gallery-lightbox');
    const lightboxImageEl = document.getElementById('gallery-lightbox-image');
    const openLightboxBtn = document.getElementById('open-gallery-lightbox');
    const closeLightboxBtn = document.getElementById('close-gallery-lightbox');
    const zoomInBtn = document.getElementById('zoom-in-lightbox');
    const zoomOutBtn = document.getElementById('zoom-out-lightbox');
    const resetZoomBtn = document.getElementById('reset-zoom-lightbox');
    const lightboxStageEl = document.getElementById('gallery-lightbox-stage');
    const lightboxPrevBtn = document.getElementById('gallery-lightbox-prev');
    const lightboxNextBtn = document.getElementById('gallery-lightbox-next');
    let currentIndex = 0;
    let zoomLevel = 1;
    const interactionGuardUntil = Date.now() + 700;

    if (!Array.isArray(images) || images.length === 0 || !imageEl) return;

    function clampZoom(value) {
      return Math.min(4, Math.max(1, value));
    }

    function updateZoom() {
      if (!lightboxImageEl) return;
      lightboxImageEl.style.transform = 'scale(' + zoomLevel + ')';
      if (resetZoomBtn) {
        resetZoomBtn.textContent = Math.round(zoomLevel * 100) + '%';
      }
    }

    function setActiveThumb(index) {
      thumbButtons.forEach(function (btn) {
        const btnIndex = Number(btn.getAttribute('data-gallery-index'));
        btn.classList.toggle('is-active', btnIndex === index);
      });
    }

    function renderImage() {
      imageEl.src = images[currentIndex];
      if (lightboxImageEl) {
        lightboxImageEl.src = images[currentIndex];
      }
      if (counterEl) {
        counterEl.textContent = (currentIndex + 1) + ' / ' + images.length;
      }
      setActiveThumb(currentIndex);
    }

    if (prevBtn && nextBtn && images.length > 1) {
      prevBtn.addEventListener('click', function () {
        currentIndex = (currentIndex - 1 + images.length) % images.length;
        renderImage();
      });

      nextBtn.addEventListener('click', function () {
        currentIndex = (currentIndex + 1) % images.length;
        renderImage();
      });
    }

    if (lightboxPrevBtn && lightboxNextBtn && images.length > 1) {
      lightboxPrevBtn.addEventListener('click', function (event) {
        event.stopPropagation();
        currentIndex = (currentIndex - 1 + images.length) % images.length;
        renderImage();
      });

      lightboxNextBtn.addEventListener('click', function (event) {
        event.stopPropagation();
        currentIndex = (currentIndex + 1) % images.length;
        renderImage();
      });
    }

    thumbButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        currentIndex = Number(btn.getAttribute('data-gallery-index'));
        renderImage();
      });
    });

    function openLightbox() {
      if (Date.now() < interactionGuardUntil) return;
      if (!lightboxEl) return;
      zoomLevel = 1;
      updateZoom();
      lightboxEl.hidden = false;
      document.body.classList.add('lightbox-open');
    }

    function closeLightbox() {
      if (!lightboxEl) return;
      lightboxEl.hidden = true;
      document.body.classList.remove('lightbox-open');
    }

    if (openLightboxBtn) {
      openLightboxBtn.addEventListener('click', openLightbox);
      openLightboxBtn.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openLightbox();
        }
      });
    }

    if (closeLightboxBtn) {
      closeLightboxBtn.addEventListener('click', closeLightbox);
    }

    if (zoomInBtn) {
      zoomInBtn.addEventListener('click', function () {
        zoomLevel = clampZoom(zoomLevel + 0.25);
        updateZoom();
      });
    }

    if (zoomOutBtn) {
      zoomOutBtn.addEventListener('click', function () {
        zoomLevel = clampZoom(zoomLevel - 0.25);
        updateZoom();
      });
    }

    if (resetZoomBtn) {
      resetZoomBtn.addEventListener('click', function () {
        zoomLevel = 1;
        updateZoom();
      });
    }

    if (lightboxEl) {
      lightboxEl.addEventListener('click', function (event) {
        if (!event.target.closest('.gallery-lightbox-shell')) {
          closeLightbox();
        }
      });
    }

    if (lightboxStageEl) {
      lightboxStageEl.addEventListener('wheel', function (event) {
        if (lightboxEl.hidden) return;
        event.preventDefault();
        zoomLevel = clampZoom(zoomLevel + (event.deltaY < 0 ? 0.2 : -0.2));
        updateZoom();
      }, { passive: false });
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && lightboxEl && !lightboxEl.hidden) {
        closeLightbox();
        return;
      }

      if (lightboxEl && !lightboxEl.hidden && images.length > 1) {
        if (event.key === 'ArrowLeft') {
          currentIndex = (currentIndex - 1 + images.length) % images.length;
          renderImage();
        }

        if (event.key === 'ArrowRight') {
          currentIndex = (currentIndex + 1) % images.length;
          renderImage();
        }
      }
    });

    updateZoom();
  })();

  (function () {
    const printBtn = document.getElementById('print-property-sheet');
    if (!printBtn) return;

    printBtn.addEventListener('click', function () {
      window.print();
    });
  })();

  (function () {
    const toggles = document.querySelectorAll('[data-collapse-target]');
    toggles.forEach(function (toggleBtn) {
      const targetId = toggleBtn.getAttribute('data-collapse-target');
      const panel = document.getElementById(targetId);
      if (!panel) return;

      function applyState(expanded) {
        toggleBtn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        panel.classList.toggle('is-collapsed', !expanded);
      }

      applyState(!panel.classList.contains('is-collapsed'));

      toggleBtn.addEventListener('click', function () {
        const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        applyState(!expanded);
      });
    });
  })();
</script>

<%- include('../partials/footer') %>
