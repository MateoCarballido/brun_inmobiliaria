<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <% const seoData = (typeof seo !== 'undefined' && seo) ? seo : {}; %>
    <title><%= seoData.title || title %></title>
    <meta name="description" content="<%= seoData.description || 'Brun Propiedades, inmobiliaria en Buenos Aires.' %>" />
    <meta name="robots" content="<%= seoData.robots || 'index,follow' %>" />
    <link rel="canonical" href="<%= seoData.canonical || siteUrl %>" />
    <link rel="icon" type="image/png" href="/images/faviconBrun.png" />
    <meta name="theme-color" content="#1d4a37" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Brun Propiedades" />
    <meta property="og:title" content="<%= seoData.title || title %>" />
    <meta property="og:description" content="<%= seoData.description || 'Brun Propiedades, inmobiliaria en Buenos Aires.' %>" />
    <meta property="og:type" content="<%= seoData.ogType || 'website' %>" />
    <meta property="og:url" content="<%= seoData.canonical || siteUrl %>" />
    <meta property="og:image" content="<%= seoData.ogImage || (siteUrl + '/images/brun-logo.png') %>" />
    <meta name="twitter:card" content="<%= seoData.twitterCard || 'summary_large_image' %>" />
    <meta name="twitter:title" content="<%= seoData.title || title %>" />
    <meta name="twitter:description" content="<%= seoData.description || 'Brun Propiedades, inmobiliaria en Buenos Aires.' %>" />
    <meta name="twitter:image" content="<%= seoData.ogImage || (siteUrl + '/images/brun-logo.png') %>" />
    <% if (seoData.structuredData) { %>
      <script type="application/ld+json"><%- JSON.stringify(seoData.structuredData) %></script>
    <% } %>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <% const currentPageClass = (typeof pageClass !== 'undefined' && pageClass) ? pageClass : ''; %>
  <body class="<%= currentPageClass %>">
    <header class="site-header">
      <div class="container nav-wrapper">
        <a class="brand brand-logo" href="/">
          <img src="/images/brun-logo.png" alt="BRUN Propiedades" />
        </a>
        <nav class="main-nav">
          <div class="nav-center">
            <a href="/propiedades">Propiedades</a>
            <a href="/contacto">Contacto</a>
            <a href="/nosotros">Nosotros</a>
          </div>

          <div class="nav-right">
            <% if (currentUser && currentUser.rol === 'admin') { %>
              <a href="/propiedades/add">Agregar propiedad</a>
            <% } %>

            <% if (!currentUser) { %>
              <a href="/users/login">Iniciar sesion</a>
              <a href="/users/register">Registrarse</a>
            <% } else { %>
              <span class="user-chip"><%= currentUser.username || currentUser.email %> (<%= currentUser.rol %>)</span>
              <form action="/users/logout" method="post" class="inline-form">
                <button type="submit" class="link-btn">Cerrar sesion</button>
              </form>
            <% } %>
          </div>
        </nav>
      </div>
    </header>
    <main class="container">
